{
  "name": "downflow",
  "version": "1.0.0",
  "private": true,
  "description": "DownFlow - a professional download manager built as a Chrome extension, with an optional local video-site helper.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.content.config.ts && node scripts/verify-build.mjs",
    "build:only": "vite build && vite build --config vite.content.config.ts && node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:report": "node scripts/test-report.mjs",
    "smoke:browser": "node scripts/smoke-extension.mjs",
    "package:store": "npm run build && node scripts/package-store.mjs",
    "test:server": "node scripts/manual-test-server.mjs",
    "native:install": "node scripts/native-install.mjs",
    "native:uninstall": "node scripts/native-uninstall.mjs",
    "native:status": "node scripts/native-status.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
