{
  "manifest_version": 3,
  "name": "DownFlow - Download Manager",
  "short_name": "DownFlow",
  "version": "1.0.0",
  "description": "A professional, local-first download manager for Chrome with queueing, segmented downloads, media detection, scheduling and statistics.",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "tabs",
    "contextMenus",
    "notifications",
    "alarms",
    "sidePanel",
    "offscreen",
    "webRequest",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "DownFlow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "dashboard.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
